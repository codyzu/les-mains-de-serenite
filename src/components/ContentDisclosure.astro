---
interface Props {
  title: string;
  eyebrow?: string;
  description?: string;
  id?: string;
}

const {title, eyebrow, description, id} = Astro.props;
---

<details
  id={id}
  class="group card-soft scroll-mt-28 overflow-hidden bg-white/86 shadow-card"
>
  <summary
    class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-5 px-6 py-5 text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-brand-strong sm:px-8 sm:py-6"
  >
    <span class="min-w-0">
      {
        eyebrow ? (
          <span class="block text-xs font-medium uppercase tracking-[0.2em] text-brand-strong/82">
            {eyebrow}
          </span>
        ) : null
      }
      <span
        class="mt-1 block font-display text-2xl leading-tight text-ink sm:text-3xl"
      >
        {title}
      </span>
      {
        description ? (
          <span class="mt-2 block text-sm leading-6 text-ink-muted">
            {description}
          </span>
        ) : null
      }
    </span>
    <span
      class="i-lucide-chevron-down h-6 w-6 shrink-0 text-brand-strong transition-transform group-open:rotate-180 motion-reduce:transition-none"
      aria-hidden="true"></span>
  </summary>

  <div class="border-t border-ink/8 px-6 pb-7 pt-6 sm:px-8 sm:pb-9 sm:pt-8">
    <slot />
  </div>
</details>
