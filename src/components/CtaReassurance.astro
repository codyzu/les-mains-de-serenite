---
import type {ReassuranceLinkData} from '../data/site';

type Props = {
  reassurance?: ReassuranceLinkData;
  largeTapTarget?: boolean;
  class?: string;
};

const {
  reassurance,
  largeTapTarget = false,
  class: className = '',
} = Astro.props;
---

{
  reassurance ? (
    <p class:list={['text-sm leading-6 text-ink/62', className]}>
      {reassurance.prefix}
      <a
        href={reassurance.href}
        class:list={[
          'rounded-md font-medium text-brand-strong underline decoration-brand-strong/30 underline-offset-4 transition hover:text-brand focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-strong focus-visible:ring-offset-2',
          largeTapTarget ? '-my-2 inline-flex min-h-11 items-center px-1' : '',
        ]}
        target="_blank"
        rel="noreferrer"
        data-analytics-event={reassurance.analyticsEvent}
      >
        {reassurance.linkText}
      </a>
      {reassurance.suffix}
    </p>
  ) : null
}
