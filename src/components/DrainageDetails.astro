---
import type {DrainageLymphatiquePageData, Locale} from '../data/site';
import ContentDisclosure from './ContentDisclosure.astro';
import IconImage from './IconImage.astro';
import TreatmentStepCards from './TreatmentStepCards.astro';

interface Props {
  locale: Locale;
  page: DrainageLymphatiquePageData;
}

const {locale, page} = Astro.props;
const sectionCopy =
  locale === 'en'
    ? {
        eyebrow: 'Useful details',
        title: 'Everything you may want to know before booking',
        intro:
          'Open the section that answers your question. The essential suitability, pricing, method, and safety information remains visible above.',
        sessionEyebrow: 'Your appointment',
      }
    : {
        eyebrow: 'Informations utiles',
        title: 'Tout ce que vous souhaitez savoir avant de réserver',
        intro:
          'Ouvrez la rubrique qui répond à votre question. Les informations essentielles sur le soin, les tarifs, la méthode et les précautions restent visibles plus haut.',
        sessionEyebrow: 'Votre rendez-vous',
      };
---

<section id="informations-utiles" class="section-pad scroll-mt-28 bg-surface">
  <div class="container-page">
    <div class="mx-auto max-w-3xl text-center">
      <p
        class="text-sm font-medium uppercase tracking-[0.22em] text-brand-strong/82"
      >
        {sectionCopy.eyebrow}
      </p>
      <h2 class="heading-lg mt-3">{sectionCopy.title}</h2>
      <p class="body-lg mt-4">{sectionCopy.intro}</p>
    </div>

    <div class="mx-auto mt-10 grid max-w-5xl gap-5" data-drainage-disclosures>
      <ContentDisclosure
        id="systeme-lymphatique"
        eyebrow={page.lymphaticSystem.eyebrow}
        title={page.lymphaticSystem.title}
        description={page.lymphaticSystem.factorsTitle}
      >
        <div class="space-y-4">
          {
            page.lymphaticSystem.paragraphs.map((paragraph, index) => (
              <p class:list={[index === 0 ? 'body-lg' : 'body-base']}>
                {paragraph}
              </p>
            ))
          }
        </div>

        <h3 class="heading-md mt-8">{page.lymphaticSystem.factorsTitle}</h3>
        <div class="mt-5 grid gap-x-8 gap-y-2 sm:grid-cols-2">
          {
            page.lymphaticSystem.factors.map((factor) => (
              <article class="flex gap-4 border-t border-ink/8 py-4">
                <IconImage
                  name={factor.icon}
                  class="h-10 w-10 shrink-0 bg-brand-soft text-brand-strong"
                  iconClass="h-4.5 w-4.5"
                />
                <div>
                  <h4 class="text-base font-semibold text-ink">
                    {factor.title}
                  </h4>
                  <p class="mt-1 text-sm leading-6 text-ink-muted">
                    {factor.description}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </ContentDisclosure>

      <ContentDisclosure
        id="seance"
        eyebrow={sectionCopy.sessionEyebrow}
        title={page.session.title}
        description={page.session.intro}
      >
        <TreatmentStepCards steps={page.session.items} />

        <div
          id="avant-apres"
          class="mt-10 scroll-mt-28 border-t border-ink/10 pt-8"
        >
          <h3 class="heading-md">{page.beforeAfter.title}</h3>
          <p class="body-base mt-3">{page.beforeAfter.intro}</p>

          <div class="mt-6 grid gap-5 lg:grid-cols-2">
            {
              [
                {
                  title: page.beforeAfter.beforeTitle,
                  items: page.beforeAfter.before,
                },
                {
                  title: page.beforeAfter.afterTitle,
                  items: page.beforeAfter.after,
                },
              ].map((group) => (
                <article class="rounded-2xl bg-surface-muted/72 p-5 sm:p-6">
                  <h4 class="text-lg font-semibold text-ink">{group.title}</h4>
                  <ul class="mt-4 space-y-3">
                    {group.items.map((item) => (
                      <li class="flex gap-3 text-sm leading-6 text-ink/76">
                        <span
                          class="i-lucide-check mt-1 h-4 w-4 shrink-0 text-brand-strong"
                          aria-hidden="true"
                        />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </div>

        <div
          id="conseils-quotidiens"
          class="mt-10 scroll-mt-28 border-t border-ink/10 pt-8"
        >
          <p
            class="text-xs font-medium uppercase tracking-[0.2em] text-brand-strong/82"
          >
            {page.dailyCare.eyebrow}
          </p>
          <h3 class="heading-md mt-2">{page.dailyCare.title}</h3>
          <p class="body-base mt-3">{page.dailyCare.intro}</p>

          <div class="mt-6 grid gap-x-8 gap-y-2 sm:grid-cols-2">
            {
              page.dailyCare.items.map((item) => (
                <article class="flex gap-4 border-t border-ink/8 py-4">
                  <IconImage
                    name={item.icon}
                    class="h-10 w-10 shrink-0 bg-brand-soft text-brand-strong"
                    iconClass="h-4.5 w-4.5"
                  />
                  <div>
                    <h4 class="text-base font-semibold text-ink">
                      {item.title}
                    </h4>
                    <p class="mt-1 text-sm leading-6 text-ink-muted">
                      {item.description}
                    </p>
                  </div>
                </article>
              ))
            }
          </div>

          <p
            class="mt-6 rounded-2xl bg-brand-soft/68 px-5 py-4 text-sm font-medium leading-6 text-ink/76"
          >
            {page.dailyCare.highlight}
          </p>
        </div>
      </ContentDisclosure>

      <ContentDisclosure
        id="situations-particulieres"
        eyebrow={page.particularSituations.eyebrow}
        title={page.particularSituations.title}
        description={page.particularSituations.intro}
      >
        <div class="grid gap-x-8 gap-y-2 md:grid-cols-2">
          {
            page.particularSituations.items.map((item) => (
              <article class="border-t border-ink/8 py-5">
                <h3 class="text-lg font-semibold text-ink">{item.title}</h3>
                <p class="body-base mt-3">{item.description}</p>
              </article>
            ))
          }
        </div>
        <p
          class="mt-6 rounded-2xl bg-accent-soft/62 px-5 py-4 text-sm font-medium leading-6 text-ink/76"
        >
          {page.particularSituations.note}
        </p>
      </ContentDisclosure>

      <ContentDisclosure
        id="faq"
        title={page.faq.title}
        description={page.faq.intro}
      >
        <div class="grid gap-x-8 gap-y-2 md:grid-cols-2">
          {
            page.faq.items.map((item) => (
              <article class="border-t border-ink/8 py-5">
                <h3 class="text-lg font-semibold leading-7 text-ink">
                  {item.question}
                </h3>
                <p class="body-base mt-3">{item.answer}</p>
              </article>
            ))
          }
        </div>
      </ContentDisclosure>
    </div>
  </div>
</section>
