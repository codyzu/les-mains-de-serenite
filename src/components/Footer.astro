---
import {Image} from 'astro:assets';
import LogoSquareLight from '../assets/logo-square-light.png';
import {defaultLocale, getLocalizedSite, site, type Locale} from '../data/site';
import {getBaseUrl} from '../utils/url';

type Props = {
  locale?: Locale;
  reserveLink?: string;
  reserveActive?: boolean;
};

const {
  locale = defaultLocale,
  reserveLink,
  reserveActive = false,
} = Astro.props;
const baseUrl = getBaseUrl();
const toHref = (path: string) =>
  path.startsWith('http') ? path : `${baseUrl}${path.replace(/^\//v, '')}`;
const homePath = locale === 'en' ? '/en/' : '/';
const homeHref = toHref(homePath);
const {
  business: {name: brand, address},
  pages,
  localized,
} = site;
const {
  chrome: {footer},
} = getLocalizedSite(locale);
const {tagline, appointmentLabel, links} = footer;
const localizedPages = localized[locale].pages;
const bookingHref = toHref(
  reserveLink || localizedPages.home.booking.bookingPath,
);
const footerLinkClass =
  'inline-flex min-h-11 items-center rounded-md px-1 no-underline transition-colors hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/85 focus-visible:ring-offset-2 focus-visible:ring-offset-brand-strong motion-reduce:transition-none';
---

<footer
  class="bg-brand-strong pb-[calc(2.5rem+env(safe-area-inset-bottom))] pt-10 text-white sm:pt-9"
>
  <div class="container-page flex flex-col items-center gap-3 text-center">
    <Image
      src={LogoSquareLight}
      alt={brand}
      width={480}
      height={480}
      class="mb-4 h-auto w-28 opacity-90 sm:w-36 lg:w-40"
      loading="lazy"
      decoding="async"
      fetchpriority="low"
    />
    <div class="font-display text-3xl">{brand}</div>
    <p class="text-white/85">{tagline}</p>
    <address class="text-sm not-italic leading-6 text-white/78">
      <span class="block">{address.streetAddress}</span>
      <span class="block">{address.postalCode} {address.addressLocality}</span>
      <span class="block">{appointmentLabel}</span>
    </address>
    <div
      class="flex flex-wrap items-center justify-center gap-x-4 gap-y-0 text-sm text-white/75"
    >
      <a href={toHref(localizedPages.soins.path)} class={footerLinkClass}>
        {links.soins}
      </a>
      <a href={toHref(localizedPages.programs.path)} class={footerLinkClass}>
        {links.program}
      </a>
      <a href={`${homeHref}#apropos`} class={footerLinkClass}>
        {links.about}
      </a>
      {
        reserveActive ? (
          <span
            aria-current="page"
            class="inline-flex min-h-11 items-center px-1 text-white"
          >
            {links.reserve}
          </span>
        ) : (
          <a
            href={bookingHref}
            class={footerLinkClass}
            data-analytics-event="reserve_click"
          >
            {links.reserve}
          </a>
        )
      }
      <a href={`${homeHref}#contact`} class={footerLinkClass}>
        {links.contact}
      </a>
      <a href={toHref(`${pages.mentionsLegalesPath}/`)} class={footerLinkClass}>
        {links.legal}
      </a>
      <a
        href={toHref(`${pages.politiqueConfidentialitePath}/`)}
        class={footerLinkClass}
      >
        {links.privacy}
      </a>
    </div>
  </div>
</footer>
