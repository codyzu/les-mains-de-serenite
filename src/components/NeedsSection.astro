---
import type {NeedsSectionData} from '../data/site';
import SectionIntro from './SectionIntro.astro';

type Props = NeedsSectionData;

const {title, intro, ctaText, items} = Astro.props;
---

<section
  id="besoins"
  class="bg-surface-muted pb-16 pt-8 sm:pb-20 sm:pt-10 lg:pb-24 lg:pt-12"
>
  <div class="container-page">
    <SectionIntro title={title} text={intro} />

    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      {
        items.map((item) => (
          <a
            href={item.href}
            class="card-soft group flex items-start gap-4 bg-white/82 p-5 no-underline shadow-soft transition duration-200 hover:-translate-y-0.5 hover:bg-white hover:shadow-card focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-strong focus-visible:ring-offset-4 focus-visible:ring-offset-surface-muted motion-reduce:transform-none motion-reduce:transition-none sm:p-6"
          >
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand-soft text-brand-strong shadow-card">
              <span class="i-lucide-sparkles h-5 w-5" aria-hidden="true" />
            </div>
            <div>
              <h3 class="text-base font-semibold leading-6 text-ink">
                {item.title}
              </h3>
              <p class="mt-2 text-sm leading-6 text-ink-muted">
                {item.description}
              </p>
              <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-brand-strong">
                {item.ctaText ?? ctaText}
                <span
                  class="i-lucide-arrow-right h-4 w-4 transition-transform group-hover:translate-x-0.5 motion-reduce:transform-none motion-reduce:transition-none"
                  aria-hidden="true"
                />
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
