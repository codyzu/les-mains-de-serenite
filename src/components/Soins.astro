---
import type {SoinsSectionData} from '../data/site';
import SectionIntro from './SectionIntro.astro';
import IconImage from './IconImage.astro';
import TreatmentPricing from './TreatmentPricing.astro';

type Props = SoinsSectionData & {
  variant?: 'home' | 'overview';
};

const {
  eyebrow,
  title,
  intro,
  introLinks,
  recommendedLabel,
  startingPriceLabel,
  ctaText,
  ctaLink,
  items,
  variant = 'overview',
} = Astro.props;
const isHome = variant === 'home';

const getCardGridClasses = (index: number) => {
  const isLastTabletCard = items.length % 2 === 1 && index === items.length - 1;
  const desktopRemainder = items.length % 3;
  const isFirstDesktopLastRow =
    desktopRemainder > 0 && index === items.length - desktopRemainder;

  return [
    'md:col-span-2',
    isLastTabletCard ? 'md:col-start-2 xl:col-start-auto' : '',
    desktopRemainder === 1 && isFirstDesktopLastRow ? 'xl:col-start-3' : '',
    desktopRemainder === 2 && isFirstDesktopLastRow ? 'xl:col-start-2' : '',
  ];
};
---

<section
  id="soins"
  class="scroll-mt-28 bg-surface pb-16 pt-10 sm:pb-20 sm:pt-12 lg:pb-24 lg:pt-16"
>
  <div class="container-page">
    <SectionIntro
      eyebrow={eyebrow}
      title={title}
      text={intro}
      textLinks={introLinks}
    />

    <div class="grid gap-6 md:grid-cols-4 xl:grid-cols-6">
      {
        items.map((item, index) => (
          <article
            id={item.anchorId}
            class:list={[
              'card-soft group flex scroll-mt-30 flex-col p-6 transition duration-200 hover:border-brand/18 hover:bg-white/86 hover:shadow-soft focus-within:border-brand/24 focus-within:shadow-soft motion-reduce:transition-none sm:p-7',
              isHome ? 'bg-white/72' : '',
              ...getCardGridClasses(index),
            ]}
          >
            <IconImage
              class={
                index % 2 === 0
                  ? 'bg-brand-soft text-brand-strong'
                  : 'bg-accent-soft text-accent'
              }
              name={item.icon}
            />

            <h3 class="heading-md text-[1.6rem]">{item.title}</h3>
            <p class="body-base mt-3">{item.description}</p>
            {isHome ? null : (
              <TreatmentPricing
                options={item.prices}
                recommendedLabel={recommendedLabel}
                class="mt-5 border-t border-ink/8 pt-4"
              />
            )}
            {!isHome && item.note ? (
              <p
                class="mt-4 rounded-2xl bg-brand-soft/55 px-4 py-3 text-sm leading-6 text-ink/76"
                data-treatment-note
              >
                {item.note}
              </p>
            ) : null}

            <div class="mt-auto pt-6">
              {isHome ? (
                <p class="border-t border-ink/8 pt-4 text-sm font-semibold text-ink">
                  {startingPriceLabel} {item.prices[0]?.price}
                </p>
              ) : null}

              {item.ctaText && item.ctaLink ? (
                <a
                  href={item.ctaLink}
                  aria-label={`${item.ctaText} — ${item.title}`}
                  class="mt-6 inline-flex min-h-[2.875rem] w-full items-center justify-center gap-2 whitespace-nowrap rounded-full border border-brand-soft bg-white/60 px-5 py-3 text-sm font-semibold text-brand-strong no-underline transition-colors hover:bg-brand-soft/60 active:bg-brand-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-strong focus-visible:ring-offset-2 motion-reduce:transition-none"
                >
                  {item.ctaText}
                  <span
                    class="i-lucide-arrow-right h-4 w-4 transition-transform group-hover:translate-x-0.5 motion-reduce:transform-none motion-reduce:transition-none"
                    aria-hidden="true"
                  />
                </a>
              ) : null}
            </div>
          </article>
        ))
      }
    </div>

    {
      ctaText && ctaLink ? (
        <div class="mt-10 flex justify-center">
          <a
            href={ctaLink}
            class="btn-primary min-h-[3.25rem] px-7 py-4 text-base"
          >
            {ctaText}
          </a>
        </div>
      ) : null
    }
  </div>
</section>
