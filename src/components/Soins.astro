---
import type {SoinsSectionData} from '../data/site';
import SectionIntro from './SectionIntro.astro';
import IconImage from './IconImage.astro';
import TreatmentPricing from './TreatmentPricing.astro';

type Props = SoinsSectionData & {
  variant?: 'home' | 'overview';
};

const {
  title,
  intro,
  introLinks,
  recommendedLabel,
  startingPriceLabel,
  ctaText,
  ctaLink,
  items,
  variant = 'overview',
} = Astro.props;
const isHome = variant === 'home';

const getCardGridClasses = (index: number) => {
  const isLastTabletCard = items.length % 2 === 1 && index === items.length - 1;
  const desktopRemainder = items.length % 3;
  const isFirstDesktopLastRow =
    desktopRemainder > 0 && index === items.length - desktopRemainder;

  return [
    'md:col-span-2',
    isLastTabletCard ? 'md:col-start-2 xl:col-start-auto' : '',
    desktopRemainder === 1 && isFirstDesktopLastRow ? 'xl:col-start-3' : '',
    desktopRemainder === 2 && isFirstDesktopLastRow ? 'xl:col-start-2' : '',
  ];
};
---

<section id="soins" class="section-pad bg-surface">
  <div class="container-page">
    <SectionIntro title={title} text={intro} textLinks={introLinks} />

    <div class="grid gap-6 md:grid-cols-4 xl:grid-cols-6">
      {
        items.map((item, index) => (
          <article
            id={item.anchorId}
            class:list={[
              'card-soft flex scroll-mt-30 flex-col p-6 sm:p-7',
              isHome ? 'bg-white/72' : '',
              ...getCardGridClasses(index),
            ]}
          >
            <IconImage
              class={
                index % 2 === 0
                  ? 'bg-brand-soft text-brand-strong'
                  : 'bg-accent-soft text-accent'
              }
              name={item.icon}
            />

            <h3 class="heading-md text-[1.6rem]">{item.title}</h3>
            <p class="body-base mt-3">{item.description}</p>
            {!isHome && item.note ? (
              <p class="mt-4 rounded-2xl bg-brand-soft/55 px-4 py-3 text-sm leading-6 text-ink/76">
                {item.note}
              </p>
            ) : null}

            {isHome ? (
              <p class="mt-6 border-t border-ink/8 pt-4 text-sm font-semibold text-ink">
                {startingPriceLabel} {item.prices[0]?.price}
              </p>
            ) : (
              <TreatmentPricing
                options={item.prices}
                recommendedLabel={recommendedLabel}
                class="mt-7 border-t border-ink/8 pt-4"
              />
            )}

            {item.ctaText && item.ctaLink ? (
              <a
                href={item.ctaLink}
                aria-label={`${item.ctaText} — ${item.title}`}
                class="mt-6 inline-flex min-h-[2.75rem] w-full items-center justify-center gap-2 rounded-full border border-brand-soft bg-white/60 px-5 py-3 text-sm font-semibold text-brand-strong no-underline transition hover:bg-brand-soft/60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
              >
                {item.ctaText}
                <span class="i-lucide-arrow-right h-4 w-4" aria-hidden="true" />
              </a>
            ) : null}
          </article>
        ))
      }
    </div>

    {
      ctaText && ctaLink ? (
        <div class="mt-10 flex justify-center">
          <a
            href={ctaLink}
            class="btn-primary min-h-[3.25rem] px-7 py-4 text-base"
          >
            {ctaText}
          </a>
        </div>
      ) : null
    }
  </div>
</section>
