---
interface Props {
  items: string[];
  class?: string;
}

const {items, class: className} = Astro.props;
---

<ul class:list={['flex flex-wrap gap-2.5 sm:gap-3', className]}>
  {
    items.map((item) => (
      <li class="rounded-full bg-white/78 px-3.5 py-2 text-[0.82rem] font-medium leading-5 text-ink shadow-card sm:px-4 sm:text-sm">
        {item}
      </li>
    ))
  }
</ul>
