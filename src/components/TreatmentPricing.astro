---
import type {SoinPriceData} from '../data/site';

interface Props {
  options: SoinPriceData[];
  recommendedLabel: string;
  optionDescriptions?: string[];
  featured?: boolean;
  class?: string;
}

const {
  options,
  recommendedLabel,
  optionDescriptions = [],
  featured = false,
  class: className,
} = Astro.props;
---

<div class:list={[featured ? 'space-y-3' : 'space-y-2', className]}>
  {
    options.map((option, index) => (
      <div
        class:list={[
          'rounded-2xl border',
          featured ? 'px-5 py-4 sm:px-6 sm:py-5' : 'px-4 py-3',
          option.recommended
            ? featured
              ? 'border-brand/28 bg-brand-soft/72 ring-1 ring-brand/8'
              : 'border-brand/20 bg-brand-soft/72'
            : 'border-ink/6 bg-white/52',
        ]}
      >
        {option.recommended ? (
          <p
            class:list={[
              'font-semibold uppercase text-brand-strong/88',
              featured
                ? 'mb-2 text-[0.72rem] tracking-[0.18em]'
                : 'mb-1 text-[0.68rem] tracking-[0.16em]',
            ]}
          >
            <span
              class="i-lucide-sparkles mr-1.5 inline-block h-3.5 w-3.5 align-[-0.18em]"
              aria-hidden="true"
            />
            {recommendedLabel}
          </p>
        ) : null}
        <div class="flex items-baseline justify-between gap-5">
          <span
            class:list={[
              featured ? 'text-lg' : 'text-sm',
              option.recommended ? 'font-semibold text-ink' : 'text-ink/68',
            ]}
          >
            {option.duration}
          </span>
          <span
            class:list={[
              'whitespace-nowrap text-right text-ink',
              featured
                ? 'font-display text-2xl leading-none sm:text-[1.7rem]'
                : 'text-sm',
              option.recommended ? 'font-bold' : 'font-medium',
            ]}
          >
            {option.price}
          </span>
        </div>
        {featured && optionDescriptions.at(index) ? (
          <p class="mt-2 max-w-[34rem] text-sm leading-6 text-ink/66">
            {optionDescriptions.at(index)}
          </p>
        ) : null}
      </div>
    ))
  }
</div>
