---
interface Step {
  title: string;
  description: string;
}

interface Props {
  steps: Step[];
  columns?: 3 | 4;
}

const {steps, columns = 4} = Astro.props;
---

<div
  class:list={[
    'grid gap-4 md:grid-cols-2',
    columns === 3 ? 'lg:grid-cols-3 lg:gap-6' : 'lg:grid-cols-4',
  ]}
>
  {
    steps.map((step, index) => (
      <article class="card-soft flex h-full flex-col bg-white/84 p-6 shadow-card sm:p-7">
        <span
          class="font-display text-4xl leading-none text-brand-strong"
          aria-hidden="true"
        >
          {index + 1}
        </span>
        <h3 class="mt-4 text-lg font-semibold leading-7 text-ink">
          <span class="sr-only">{index + 1}. </span>
          {step.title}
        </h3>
        <p class="mt-3 text-sm leading-6 text-ink-muted">{step.description}</p>
      </article>
    ))
  }
</div>
