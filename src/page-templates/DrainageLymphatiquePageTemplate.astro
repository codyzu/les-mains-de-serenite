---
import {Picture} from 'astro:assets';
import CtaReassurance from '../components/CtaReassurance.astro';
import DrainageDetails from '../components/DrainageDetails.astro';
import IconImage from '../components/IconImage.astro';
import RelatedTreatmentCards from '../components/RelatedTreatmentCards.astro';
import TreatmentMetaPills from '../components/TreatmentMetaPills.astro';
import TreatmentPricing from '../components/TreatmentPricing.astro';
import DrainageHeroImage from '../assets/drainage-lymphatique-renata-franca.png';
import {getTreatmentPrices} from '../data/site/catalog/treatments';
import {
  localizedPagePaths,
  type Locale,
  type LocalizedSiteData,
  type SiteBusinessData,
} from '../data/site';
import Layout from '../layouts/Layout.astro';

interface Props {
  locale: Locale;
  business: SiteBusinessData;
  localized: LocalizedSiteData;
}

const {locale, business, localized} = Astro.props;
const {
  pages: {drainageLymphatique: page},
} = localized;
const languageSwitchPaths = localizedPagePaths.drainageLymphatique;
const ctaIsExternal = page.cta.href.startsWith('http');
const treatmentPrices = getTreatmentPrices('lymphaticDrainage');
const pricingCopy =
  locale === 'en'
    ? {
        eyebrow: 'Durations and prices',
        title: 'Choose your session length',
        description: 'Choose the pace that best suits what you need today.',
        recommendedLabel: 'Recommended',
        optionDescriptions: [
          'Recommended for discovering the complete full-body treatment.',
          'More time for areas needing particular attention and a slower return to calm.',
        ],
      }
    : {
        eyebrow: 'Durées et tarifs',
        title: 'Choisissez la durée de votre soin',
        description:
          'Choisissez le rythme qui correspond le mieux à votre besoin du moment.',
        recommendedLabel: 'Durée conseillée',
        optionDescriptions: [
          'La durée recommandée pour découvrir le soin complet du corps.',
          'Plus de temps pour les zones qui demandent une attention particulière et un retour au calme plus lent.',
        ],
      };
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: page.meta.title,
  description: page.meta.description,
  image: new URL(DrainageHeroImage.src, business.siteUrl).href,
  serviceType:
    locale === 'en'
      ? 'Renata França lymphatic drainage wellness treatment'
      : 'Soin bien-être de drainage lymphatique Renata França',
  provider: {
    '@type': business.seo.schemaType,
    name: business.name,
    telephone: business.phone,
    address: {
      '@type': 'PostalAddress',
      ...business.address,
    },
  },
  areaServed: business.seo.areaServed,
  offers: treatmentPrices.map((option) => ({
    '@type': 'Offer',
    price: option.price.replaceAll(/[^\d,.]/gv, ''),
    priceCurrency: 'EUR',
    description: option.duration,
  })),
};
---

<Layout
  locale={locale}
  canonicalPath={page.path}
  alternatePaths={languageSwitchPaths}
  languageSwitchPaths={languageSwitchPaths}
  title={page.meta.title}
  description={page.meta.description}
  openGraphTitle={page.meta.openGraphTitle}
  openGraphDescription={page.meta.openGraphDescription}
  structuredData={structuredData}
>
  <main>
    <section class="overflow-hidden bg-surface-muted">
      <div
        class="container-page grid gap-7 pb-16 pt-14 sm:gap-10 sm:pb-20 sm:pt-18 lg:grid-cols-[minmax(0,0.95fr)_minmax(22rem,0.8fr)] lg:items-center lg:gap-14 lg:pb-16 lg:pt-16"
      >
        <div class="max-w-3xl">
          <p
            class="mb-4 text-sm uppercase tracking-[0.25em] text-brand-strong/90"
          >
            {
              locale === 'en'
                ? 'Renata França method in Annecy'
                : 'Méthode Renata França à Annecy'
            }
          </p>
          <h1 class="font-display text-5xl leading-tight text-ink sm:text-6xl">
            {page.hero.title}
          </h1>
          <p
            class="mt-6 max-w-2xl text-pretty text-lg leading-8 text-ink-muted sm:text-xl"
          >
            {page.hero.description}
          </p>

          <TreatmentMetaPills items={page.hero.keyInfo} class="mt-7" />

          <a
            href={page.cta.href}
            target={ctaIsExternal ? '_blank' : undefined}
            rel={ctaIsExternal ? 'noreferrer' : undefined}
            class="btn-primary mt-9 min-h-[3rem] w-full px-7 py-3.5 sm:min-h-0 sm:w-auto sm:py-3"
            data-analytics-event={page.cta.analyticsEvent}
          >
            {page.hero.primaryCta}
          </a>
          <p class="mt-4 max-w-xl text-sm leading-6 text-ink/62">
            {page.reassuranceNote}
          </p>
        </div>

        <div
          class="mx-auto max-w-[30rem] overflow-hidden rounded-[2rem] shadow-soft ring-1 ring-surface-soft lg:mx-0 lg:max-w-none"
        >
          <Picture
            priority
            src={DrainageHeroImage}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[320, 448, 640, 768, 1086]}
            width={448}
            height={597}
            sizes="(min-width: 1024px) 31rem, (min-width: 640px) 30rem, calc(100vw - 2rem)"
            alt={page.hero.imageAlt}
            class="h-auto w-full object-cover lg:max-h-[36rem]"
          />
        </div>
      </div>
    </section>

    <section id="pour-vous" class="section-pad scroll-mt-28 bg-surface">
      <div class="container-page">
        <div class="grid gap-6 lg:grid-cols-2 lg:items-start">
          <article class="card-soft bg-white/86 p-6 shadow-card sm:p-8">
            <h2 class="heading-lg">{page.forYou.title}</h2>
            <p class="body-lg mt-4">{page.forYou.intro}</p>

            <div class="mt-6 grid gap-x-7 sm:grid-cols-2">
              {
                page.forYou.items.map((item) => (
                  <div class="flex gap-3 border-t border-ink/8 py-4">
                    <IconImage
                      name={item.icon}
                      class="h-9 w-9 shrink-0 bg-brand-soft text-brand-strong"
                      iconClass="h-4 w-4"
                    />
                    <div>
                      <h3 class="text-base font-semibold text-ink">
                        {item.title}
                      </h3>
                      <p class="mt-1 text-sm leading-6 text-ink-muted">
                        {item.description}
                      </p>
                    </div>
                  </div>
                ))
              }
            </div>
          </article>

          <article class="card-soft bg-brand-soft/46 p-6 shadow-card sm:p-8">
            <h2 class="heading-lg">{page.benefits.title}</h2>
            <p class="body-lg mt-4">{page.benefits.intro}</p>

            <div class="mt-6 grid gap-x-7 sm:grid-cols-2">
              {
                page.benefits.items.map((item) => (
                  <div class="flex gap-3 border-t border-ink/8 py-4">
                    <IconImage
                      name={item.icon}
                      class="h-9 w-9 shrink-0 bg-accent-soft text-accent-strong"
                      iconClass="h-4 w-4"
                    />
                    <div>
                      <h3 class="text-base font-semibold text-ink">
                        {item.title}
                      </h3>
                      <p class="mt-1 text-sm leading-6 text-ink-muted">
                        {item.description}
                      </p>
                    </div>
                  </div>
                ))
              }
            </div>

            <p
              class="mt-5 rounded-2xl bg-white/66 px-5 py-4 text-sm leading-6 text-ink/72"
            >
              {page.benefits.note}
            </p>
          </article>
        </div>
      </div>
    </section>

    <section
      id="tarifs"
      class="scroll-mt-28 bg-surface-muted pb-16 pt-18 sm:py-20 lg:py-24"
    >
      <div class="container-page">
        <div
          class="mx-auto grid max-w-5xl gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.72fr)] lg:items-center lg:gap-12"
        >
          <div>
            <p
              class="text-sm font-medium uppercase tracking-[0.22em] text-brand-strong/82"
            >
              {pricingCopy.eyebrow}
            </p>
            <h2 class="heading-lg mt-3">{pricingCopy.title}</h2>
            <p class="body-lg mt-5">{pricingCopy.description}</p>
          </div>
          <div class="card-soft bg-white/88 p-6 pb-7 shadow-soft sm:p-7">
            <TreatmentPricing
              options={treatmentPrices}
              recommendedLabel={pricingCopy.recommendedLabel}
              optionDescriptions={pricingCopy.optionDescriptions}
              featured
            />
            <div class="mt-6 border-t border-ink/8 pt-6">
              <a
                href={page.cta.href}
                target={ctaIsExternal ? '_blank' : undefined}
                rel={ctaIsExternal ? 'noreferrer' : undefined}
                class="btn-primary min-h-[3.25rem] w-full whitespace-nowrap px-4 py-3.5 text-center text-[0.82rem] sm:px-6 sm:text-base"
                data-analytics-event={page.cta.analyticsEvent}
              >
                {page.hero.primaryCta}
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section-pad bg-surface">
      <div class="container-page">
        <div
          class="grid gap-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(19rem,0.65fr)] lg:items-start lg:gap-12"
        >
          <div>
            <h2
              class="font-display text-[1.625rem] leading-[1.2] text-ink sm:text-4xl sm:leading-tight"
            >
              {
                locale === 'fr' ? (
                  <>
                    <span class="sr-only">
                      La méthode Renata França : un drainage dynamique et précis
                    </span>
                    <span aria-hidden="true">
                      <span class="block sm:inline">
                        La méthode Renata França
                      </span>{' '}
                      <span class="block sm:hidden">
                        Un drainage dynamique et précis
                      </span>
                      <span class="hidden sm:inline">
                        : un drainage dynamique et précis
                      </span>
                    </span>
                  </>
                ) : (
                  page.method.title
                )
              }
            </h2>
            <div class="mt-5 space-y-4">
              {
                page.method.paragraphs.map((paragraph, index) => (
                  <p class:list={[index === 0 ? 'body-lg' : 'body-base']}>
                    {paragraph}
                  </p>
                ))
              }
            </div>
          </div>

          <aside
            class="card-soft bg-brand-soft/68 p-6 shadow-card sm:p-8 lg:sticky lg:top-28"
          >
            <IconImage
              name="i-lucide-waves"
              class="bg-white/74 text-brand-strong"
            />
            <p class="font-display text-2xl leading-9 text-ink">
              {page.method.highlight}
            </p>
          </aside>
        </div>
      </div>
    </section>

    <section
      id="pourquoi-nous"
      class="scroll-mt-28 bg-surface-muted pb-16 pt-18 sm:py-20 lg:py-24"
    >
      <div class="container-page">
        <div
          class="grid overflow-hidden rounded-[2rem] bg-ink shadow-soft lg:grid-cols-[minmax(20rem,0.8fr)_minmax(0,1.2fr)] lg:items-stretch"
        >
          <Picture
            src={DrainageHeroImage}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[360, 520, 704, 900]}
            width={704}
            height={704}
            sizes="(min-width: 1024px) 34rem, calc(100vw - 2rem)"
            alt={page.hero.imageAlt}
            class="h-[26rem] w-full object-cover object-[50%_38%] lg:h-full lg:min-h-[42rem]"
          />

          <div class="px-7 pb-9 pt-8 text-white sm:p-10 lg:p-12">
            <p class="text-sm uppercase tracking-[0.25em] text-white/68">
              {page.approach.eyebrow}
            </p>
            <h2 class="mt-4 font-display text-3xl leading-tight sm:text-4xl">
              {page.approach.title}
            </h2>
            <div class="mt-6 space-y-4 text-base leading-7 text-white/82">
              {page.approach.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
            <ul class="mt-7 grid gap-3 sm:grid-cols-2">
              {
                page.approach.points.map((item) => (
                  <li class="flex gap-3 rounded-2xl bg-white/9 px-4 py-3 text-sm leading-6 text-white/88">
                    <span
                      class="i-lucide-check mt-1 h-4 w-4 shrink-0 text-brand-soft"
                      aria-hidden="true"
                    />
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section id="precautions" class="section-pad scroll-mt-28 bg-surface">
      <div class="container-page">
        <div
          class="card-soft mx-auto max-w-5xl bg-white/84 p-6 shadow-soft sm:p-9"
        >
          <div
            class="grid gap-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]"
          >
            <div>
              <IconImage
                name="i-lucide-circle-alert"
                class="bg-accent-soft text-accent-strong"
              />
              <h2 class="heading-lg">{page.precautions.title}</h2>
              <p class="body-base mt-4">{page.precautions.description}</p>
            </div>

            <div>
              <ul class="grid gap-3 sm:grid-cols-2">
                {
                  page.precautions.items.map((item) => (
                    <li class="flex gap-3 rounded-2xl bg-surface-muted/70 px-4 py-3 text-sm font-medium leading-6 text-ink/78">
                      <span
                        class="i-lucide-info mt-1 h-4 w-4 shrink-0 text-accent-strong"
                        aria-hidden="true"
                      />
                      <span>{item}</span>
                    </li>
                  ))
                }
              </ul>
              <p
                class="mt-5 rounded-2xl bg-accent-soft/56 px-5 py-4 text-sm leading-6 text-ink/74"
              >
                {page.precautions.note}
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <DrainageDetails locale={locale} page={page} />

    <section
      id="a-decouvrir"
      class="scroll-mt-28 bg-surface px-0 pb-12 pt-18 sm:py-16"
    >
      <div class="container-page">
        <div class="mx-auto max-w-5xl">
          <div class="mx-auto max-w-3xl text-center">
            <p class="text-sm uppercase tracking-[0.22em] text-brand-strong/82">
              {page.related.eyebrow}
            </p>
            <h2 class="heading-md mt-3">{page.related.title}</h2>
            <p class="body-base mt-4">{page.related.description}</p>
          </div>

          <div class="mt-8">
            <RelatedTreatmentCards items={page.related.items} />
          </div>
        </div>
      </div>
    </section>

    <section
      id="reservation"
      class="scroll-mt-28 bg-surface-muted pb-16 pt-12 sm:py-20 lg:py-24"
    >
      <div class="container-page">
        <div
          class="card-soft mx-auto max-w-4xl p-7 text-center shadow-soft sm:p-10 lg:p-12"
        >
          <IconImage
            name="i-lucide-calendar-heart"
            class="mx-auto bg-brand-soft text-brand-strong"
          />
          <h2 class="heading-lg">{page.cta.title}</h2>
          <p class="body-lg mx-auto mt-4 max-w-2xl">
            {page.cta.description}
          </p>
          <a
            href={page.cta.href}
            target={ctaIsExternal ? '_blank' : undefined}
            rel={ctaIsExternal ? 'noreferrer' : undefined}
            class="btn-primary mt-7 min-h-[3rem] whitespace-nowrap px-4 py-3.5 text-[0.82rem] sm:px-7 sm:py-3 sm:text-sm"
            data-analytics-event={page.cta.analyticsEvent}
          >
            {page.cta.text}
          </a>
          <CtaReassurance
            reassurance={page.cta.reassurance}
            largeTapTarget
            class="mx-auto mt-4 max-w-2xl"
          />
          <p class="mx-auto mt-4 max-w-2xl text-sm leading-6 text-ink/58">
            {page.reassuranceNote}
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>
